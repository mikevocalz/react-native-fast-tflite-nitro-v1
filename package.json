{
  "name": "react-native-fast-tflite",
  "version": "3.0.1-nitro-v1.0",
  "description": "High-performance TensorFlow Lite library for React Native, built with Nitro Modules (Nitro V1 alpha port)",
  "main": "lib/index",
  "module": "lib/index",
  "types": "lib/index.d.ts",
  "react-native": "lib/index",
  "source": "src/index",
  "imports": {
    "#nitro/*": "./nitrogen/generated/shared/javascript/*.cjs"
  },
  "files": [
    "src",
    "lib",
    "nitrogen",
    "android/build.gradle",
    "android/gradle.properties",
    "android/fix-prefab.gradle",
    "android/CMakeLists.txt",
    "android/src",
    "!android/src/main/cpp/lib",
    "apple/**/*.swift",
    "cpp/**/*.h",
    "cpp/**/*.hpp",
    "cpp/**/*.cpp",
    "nitro.json",
    "Package.swift",
    "*.podspec",
    "nitro_v1_cocoapods.rb",
    "react-native.config.js",
    "app.plugin.js",
    "README.md",
    "NOTICE"
  ],
  "scripts": {
    "specs": "nitrogen --logLevel=\"debug\"",
    "typecheck": "tsc --noEmit && tsc --noEmit --project tsconfig.expo-plugin.json",
    "build": "tsc --noEmit false && tsc --project tsconfig.expo-plugin.json",
    "clean": "rm -rf lib android/build android/.cxx android/src/main/cpp/lib",
    "lint-cpp": "scripts/clang-format.sh",
    "build-release-branches": "node scripts/build-release-branches.mjs",
    "prepack": "bun run build",
    "example": "bun --cwd example"
  },
  "keywords": [
    "react-native",
    "tensorflow",
    "vision-camera",
    "tflite",
    "lite",
    "tensorflowlite",
    "tensorflow-lite",
    "visioncamera",
    "react-native-vision-camera",
    "vision",
    "camera",
    "ios",
    "android",
    "nitro"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mikevocalz/react-native-fast-tflite-nitro-v1.git"
  },
  "author": "Marc Rousavy <me@mrousavy.com> (https://github.com/mrousavy)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/mikevocalz/react-native-fast-tflite-nitro-v1/issues"
  },
  "homepage": "https://github.com/mikevocalz/react-native-fast-tflite-nitro-v1#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@expo/config-plugins": "^7.8.4",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "nitro-core": "1.0.0-alpha.nightly.138.g43e09c161101",
    "nitrogen": "1.0.0-alpha.nightly.138.g43e09c161101",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-nitro-modules": "1.0.0-alpha.nightly.138.g43e09c161101",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": ">=0.88.0-0",
    "nitro-core": "*",
    "react-native-nitro-modules": "*"
  },
  "peerDependenciesMeta": {
    "nitro-core": {
      "optional": true
    },
    "react-native-nitro-modules": {
      "optional": true
    }
  },
  "engines": {
    "node": ">= 20.19.4"
  },
  "prettier": {
    "quoteProps": "consistent",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "swiftpmConfig": {
    "name": "NitroTflite",
    "dependencies": [
      "react-native-nitro-modules"
    ]
  }
}
